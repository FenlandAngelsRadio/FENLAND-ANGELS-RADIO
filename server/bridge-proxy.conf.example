# Install only behind a verified TLS certificate and provider firewall.
# Never expose ARI (8779), the staff queue (8768), or DJ control (8765) directly.
# The bridges authenticate their own distinct bearer tokens on every request.
server {
    listen 443 ssl;
    server_name REPLACE_WITH_VERIFIED_CONTROL_HOSTNAME;
    ssl_certificate /etc/letsencrypt/live/REPLACE_WITH_VERIFIED_CONTROL_HOSTNAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WITH_VERIFIED_CONTROL_HOSTNAME/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16k;
    add_header Cache-Control "no-store" always;
    location /dj/ {
        proxy_pass http://127.0.0.1:8765/;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 120s;
    }
    location = /calls/queue {
        proxy_pass http://127.0.0.1:8768/queue;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 15s;
    }
    location / { return 404; }
}
