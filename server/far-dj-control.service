[Unit]
Description=FAR Live DJ Control Bridge
After=network.target
[Service]
Type=simple
User=root
EnvironmentFile=/etc/far-live/dj-control.env
ExecStart=/usr/bin/python3 /opt/far-live/dj-control.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/far-live
[Install]
WantedBy=multi-user.target
